---
// DesignSystem/Web: uz-site-navigation.
import "../../DesignSystem/Web/uzume-components.css";

// Only pages that exist — lychee fails the build on dangling internal links.
// /download joins at W.7.
const links = [
  { href: "/gallery", label: "Gallery" },
  { href: "/docs", label: "Docs" },
  { href: "https://github.com/hoaxpoet/uzume", label: "GitHub" },
];

// Trailing slash tolerated so /docs/ matches /docs.
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav class="uz-site-navigation" aria-label="Site">
  <a class="uz-site-navigation__brand" href="/">
    Uzume
  </a>
  {links.map(({ href, label }) => (
    <a
      class="uz-site-navigation__link"
      href={href}
      aria-current={here === href ? "page" : undefined}
    >
      {label}
    </a>
  ))}
</nav>

<style>
  /* Live text, not the outlined SVG. BRAND.md wrote that rule before the site
     served Alumni Sans; the wordmark file is itself outlined Alumni Sans
     SemiBold letterforms, so set in the real face at 600 it is the same
     drawing — and it is selectable, scales with the reader's text settings,
     and needs no separate asset.

     The header carries the name on every page now, including the homepage.
     The hero's own lockup is gone — the claim is the h1 there — so there is no
     longer a second lockup to hand off from, and the scroll-driven handoff
     this component used to run went with it. */
  .uz-site-navigation__brand {
    width: auto;
    font: var(--font-weight-semibold) var(--text-2xl) / 1 var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .uz-site-navigation__brand:focus-visible {
    outline: 0;
    border-radius: var(--radius-sm);
    box-shadow: var(--focus-ring);
  }

  .uz-site-navigation {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-line);
  }
</style>
