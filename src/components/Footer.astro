---
// Not a catalogue component — the design system has no footer. Tokens only.
const year = new Date().getFullYear();
---

<footer>
  <div class="footer__meta">
    <p>
      Uzume · <a href="https://github.com/hoaxpoet/uzume">Source on GitHub</a>
    </p>
    <p class="footer__tagline">
      “A light in sound, a sound-like power in light.” — Coleridge, 1795
    </p>
    <p>&copy; {year} Matt Deming</p>
  </div>
</footer>

<style>
  footer {
    padding: var(--space-10) var(--page-gutter) var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  /* BRAND.md asks the tagline to be an atmospheric close, not the product
     explanation. A centred 2xl blockquote with the last word on every page is
     the opposite of atmospheric — it was the loudest thing in the footer, on a
     site whose own voice is plain and unhurried. Small type beside the
     attribution keeps the line and lets it be a signature. */
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .footer__meta p {
    margin: 0;
  }

  .footer__tagline {
    color: var(--color-text-tertiary);
  }
</style>
