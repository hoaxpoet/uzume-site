---
// Not a catalogue component — the design system has no footer. Tokens only.
const year = new Date().getFullYear();
---

<footer>
  <p>
    Uzume · <a href="https://github.com/hoaxpoet/uzume">Source on GitHub</a>
  </p>
  <p>&copy; {year} Matt Deming</p>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-8) var(--page-gutter);
    border-top: 1px solid var(--color-line);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  p {
    margin: 0;
  }
</style>
