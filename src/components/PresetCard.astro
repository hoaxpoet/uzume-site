---
// DesignSystem/Web: uz-preset-card. Identity survives missing media.
import "../../DesignSystem/Web/uzume-components.css";

interface Props {
  name: string;
  author: string;
  /** Poster still; the gallery's moving previews arrive with W.3 footage. */
  poster?: string;
  /**
   * The same still as AVIF. The encoder has been producing these all along and
   * the manifest has been carrying them — 979 kB against 1,554 kB of JPEG —
   * and nothing referenced them. Optional, and a <source> either way, so a
   * browser without AVIF still gets the JPEG.
   */
  posterAvif?: string;
  /**
   * Optional third line. No default: the card used to print
   * "Certified · steady luminance" on every instance, which is a constant
   * carrying no information, in vocabulary that means nothing to a listener.
   * A caller with something specific to say about one preset can still say it.
   */
  status?: string;
}

const { name, author, poster, posterAvif, status } = Astro.props;
---

<figure class="uz-preset-card">
  <div class="uz-preset-card__media">
    {poster ? (
      <picture>
        {posterAvif && <source srcset={posterAvif} type="image/avif" />}
        <img
          src={poster}
          alt={`${name} preview still`}
          loading="lazy"
          width="1920"
          height="1080"
        />
      </picture>
    ) : (
      <div>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m8 15 3-3 2 2 3-4 3 5" />
        </svg>
        <strong>Preview unavailable</strong>
        <span>The preset remains identifiable without its media.</span>
      </div>
    )}
  </div>
  <figcaption class="uz-preset-card__caption">
    <span class="uz-preset-card__identity">
      <strong class="uz-preset-card__title">{name}</strong>
      <span class="uz-preset-card__author">{author}</span>
    </span>
    {status && <span class="uz-preset-card__status">{status}</span>}
  </figcaption>
</figure>
