---
// DesignSystem/Web: uz-media-frame, with the video case filled in.
import "../../DesignSystem/Web/uzume-components.css";

/** One entry from `src/data/media.json`'s `renditions`, passed through whole. */
export interface Rendition {
  url: string;
  type: string;
}

interface Props {
  title: string;
  meta?: string;
  poster?: string;
  /**
   * The same still as AVIF. `<video poster>` takes one URL and cannot
   * content-negotiate, so the format is chosen in script — see the poster
   * block at the foot of this file.
   */
  posterAvif?: string;
  /**
   * The same still at 960 wide, JPEG and AVIF. Offered to screens that cannot
   * show the full one's pixels — which is every phone, and phones are exactly
   * where the poster is not a placeholder but the whole image, because a narrow
   * screen never plays the loop. Optional: without it the full poster is used
   * at every size, which is the old behaviour.
   */
  thumb?: string;
  thumbAvif?: string;
  /** Encoded variants, best first: AV1/WebM then H.264/MP4. */
  sources?: Rendition[];
  /**
   * Background footage: the bare <video>, no frame, no caption, no controls,
   * and hidden from assistive technology. The performance it shows is named
   * and operable on /gallery; a second, unlabelled tab stop at the top of the
   * landing page would only be in the way.
   */
  bare?: boolean;
  /**
   * The element the caption's title renders as. `strong` by default, which is
   * what a tile inside a larger argument wants. A page whose content *is* the
   * tiles passes a heading, so the performances reach the heading outline and
   * a screen reader can navigate between them.
   */
  titleAs?: "strong" | "h2" | "h3";
}

const {
  title,
  meta,
  poster,
  posterAvif,
  thumb,
  thumbAvif,
  sources = [],
  bare = false,
  titleAs = "strong",
} = Astro.props;
const TitleTag = titleAs;
---

{bare ? (
  <Fragment>
    <video
      data-uz-loop
      class="uz-bare-loop"
      data-poster={poster}
      data-poster-avif={posterAvif}
      data-thumb={thumb}
      data-thumb-avif={thumbAvif}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    >
      {/*
        The manifest's `type` verbatim, codecs parameter and all. Built from the
        extension instead, Safari on M1/M2 — which has no AV1 hardware decoder —
        answers "maybe" to `video/webm`, commits to the AV1 file and fails rather
        than falling through to the H.264 source. With `codecs="av01…"` it
        declines outright and plays the MP4. Never rebuild this from the filename.
      */}
      {sources.map(({ url, type }) => (
        <source src={url} type={type} />
      ))}
    </video>
    {/* WCAG 2.2.2: motion that starts by itself and runs past five seconds owes
        the visitor a way to stop it, and that obligation is not conditioned on
        prefers-reduced-motion — it covers people with vestibular or attention
        conditions who have never touched the setting. The framed tiles below
        carry native controls and are already covered; the bare loop had
        nothing.

        The comment above argues the hero should not become a second
        *unlabelled* tab stop. It doesn't, because this is labelled: it names
        its action, it is the only control in the band, and the script reveals
        it only when there is motion to stop. Under reduced motion, on a phone,
        or on a metered connection the poster stands and the button never
        appears.

        One word, not four. "Pause the performance" was the accessible name
        written as visible copy — it read as the page explaining itself, and at
        219px it was the second thing your eye found in a band that exists to
        show the footage. A media control is the one place a bare verb is the
        clearest possible label. 44px stays: it is the target floor, not a size
        choice, so the button shrinks in width and in type weight instead. */}
    <button
      class="uz-button uz-button--secondary uz-loop-toggle"
      type="button"
      data-uz-loop-toggle
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path data-uz-loop-icon d="M9 5v14M15 5v14" />
      </svg>
      <span data-uz-loop-label>Pause</span>
    </button>
  </Fragment>
) : (
  <figure class="uz-media-frame">
    <div class="uz-media-frame__content">
      {sources.length ? (
        <video
          data-uz-loop
          data-poster={poster}
          data-poster-avif={posterAvif}
          data-thumb={thumb}
          data-thumb-avif={thumbAvif}
          controls
          muted
          loop
          playsinline
          preload="none"
          aria-label={title}
        >
          {/* The manifest's `type` verbatim — see the note above. */}
          {sources.map(({ url, type }) => (
            <source src={url} type={type} />
          ))}
        </video>
      ) : (
        <div
          class="uz-media-frame__fallback"
          role="img"
          aria-label={`${title} — preview unavailable`}
        >
          <div>
            <strong>Performance preview unavailable</strong>
            <span>
              The title and attribution remain available while media is missing.
            </span>
          </div>
        </div>
      )}
    </div>
    <figcaption class="uz-media-frame__caption">
      <TitleTag class="uz-media-frame__title">{title}</TitleTag>
      {meta && <span class="uz-media-frame__meta">{meta}</span>}
    </figcaption>
  </figure>
)}

<style>
  .uz-bare-loop {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The page positions the crop; the component only fills its stage. */
    object-position: var(--uz-loop-position, 50% 50%);
  }

  /* In the band's own corner, over the footage. z-index 2 clears both the
     stage's gradient and the lockup, which sits at 1 — they never overlap, but
     the lockup is centred and this is not, so the order should not depend on
     that staying true. The stage is the positioned ancestor; `bare` is the
     hero's mode and only the hero's. */
  .uz-loop-toggle {
    position: absolute;
    z-index: 2;
    right: var(--space-4);
    bottom: var(--space-4);
    /* The catalogue's button is sized for a page's primary action. This is a
       media control in the corner of the thing it controls: it has to be
       findable and reach the 44px target floor, and nothing beyond that. */
    gap: var(--space-2);
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
  }

  .uz-loop-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The play triangle is a filled shape, not a stroked outline. */
  .uz-loop-toggle[data-playing="false"] svg path {
    fill: currentColor;
  }
</style>

<script>
  // The site's only client JS. Loops play when visible and motion is welcome;
  // otherwise the poster stands and the framed tiles' native controls still
  // offer playback. Every loop is preload="none", so a loop that is never
  // played costs its poster and not one byte of video.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // Agreed with Matt at W.3b: the hero loop is 15.4 MB and its poster is 93 kB.
  // A phone on a metered connection gets the poster. 48rem is the catalogue's
  // own narrow breakpoint.
  const metered =
    (navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection?.saveData === true;
  const narrow = matchMedia("(max-width: 48rem)").matches;

  /* Posters, lazily and in the best format the browser will take.

     `<video poster>` is the one image on the page that can do neither by
     itself: it takes a single URL, so no <picture> negotiation, and it has no
     loading="lazy", so every poster on a page fetches at load. /gallery was
     paying 1,553,503 B of JPEG before a single frame played — 95% of the
     page's weight, the same on a phone as on a desktop — while 978,994 B of
     AVIF sat published and unreachable.

     No feature detection: the AVIF is simply fetched, and the handler that
     fires decides. A browser that cannot decode it errors and gets the JPEG,
     which is per-image and self-correcting rather than a capability guess.
     The fetched AVIF is already in cache when `poster` is assigned.

     This runs outside the motion gate below on purpose. A visitor under
     reduced motion, on a phone, or on a metered connection never plays a
     loop — the poster is the whole tile for them, and it is the one thing
     they must still get. */

  /* Which of the two renditions, once the element has been laid out and its
     real drawn width is known. The narrow one is 960 (W.5n); `need` is what the
     screen could actually resolve.

     The 1.25 is a judgement and it has a cost worth stating. A DPR 3 phone at
     393 CSS px needs about 1180 device pixels and gets 960 — roughly 82 % —
     so the densest frames soften slightly on exactly the screens where the
     poster is the final image rather than a placeholder. It is deliberate:
     those are also the screens most likely to be metered, and the alternative
     is 199 kB instead of 78 for Ferrofluid Ocean. A 1280-wide rendition would
     remove the compromise; add one if this ever reads as soft on a real phone.

     A zero width means the element is not laid out, and a guess would be worse
     than the full file. */
  const NARROW_WIDTH = 960;
  function rendition(video: HTMLVideoElement) {
    const need = video.clientWidth * (window.devicePixelRatio || 1);
    const narrow = need > 0 && need <= NARROW_WIDTH * 1.25;
    const { poster, posterAvif, thumb, thumbAvif } = video.dataset;
    return narrow && (thumb || thumbAvif)
      ? { jpeg: thumb, avif: thumbAvif }
      : { jpeg: poster, avif: posterAvif };
  }

  function showPoster(video: HTMLVideoElement) {
    if (video.poster) return;
    const { jpeg, avif } = rendition(video);
    if (!jpeg && !avif) return;
    if (!avif) {
      video.poster = jpeg!;
      return;
    }
    const probe = new Image();
    probe.addEventListener("load", () => {
      video.poster = avif;
    });
    probe.addEventListener("error", () => {
      if (jpeg) video.poster = jpeg;
    });
    probe.src = avif;
  }

  /* A poster that never arrives is a black rectangle where a scene should be,
     so laziness is the optimisation and showing the image is the requirement.
     Without IntersectionObserver every poster is assigned at once: the old
     behaviour, which was merely wasteful rather than broken. */
  if (!("IntersectionObserver" in window)) {
    for (const video of document.querySelectorAll<HTMLVideoElement>(
      "video[data-poster], video[data-poster-avif]",
    )) {
      showPoster(video);
    }
  } else {
  const posterObserver = new IntersectionObserver(
    (entries, observer) => {
      for (const { target, isIntersecting } of entries) {
        if (!isIntersecting) continue;
        showPoster(target as HTMLVideoElement);
        observer.unobserve(target);
      }
    },
    // Enough lead that a tile is never blank by the time it is looked at.
    { rootMargin: "400px" },
  );

  for (const video of document.querySelectorAll<HTMLVideoElement>(
    "video[data-poster], video[data-poster-avif]",
  )) {
    // The hero is the first thing on screen; waiting on an observer to notice
    // that would be a slower first paint, not a saving.
    if (video.classList.contains("uz-bare-loop")) showPoster(video);
    else posterObserver.observe(video);
  }
  }

  if (!reduced && !metered && !narrow) {
    const PAUSE_ICON = "M9 5v14M15 5v14";
    const PLAY_ICON = "M8 5l12 7-12 7Z";

    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-uz-loop-toggle]",
    );
    const icon = toggle?.querySelector("[data-uz-loop-icon]");
    const label = toggle?.querySelector("[data-uz-loop-label]");
    // The choice should survive a trip to /gallery and back, not just a scroll
    // — and it reaches /gallery too, where there is no button but there are
    // eight loops. Someone who asked the hero to stop has asked the site to
    // stop; the framed tiles keep their native controls, so a deliberate play
    // is still one click. Verified: with this set, a dwell on a gallery tile
    // fetches nothing.
    let stopped = sessionStorage.getItem("uz-loops") === "stopped";

    const ratios = new Map<HTMLVideoElement, number>();
    // Tiles the visitor started themselves, through the framed tiles' native
    // controls. Those are theirs: we neither replace them nor compete with
    // them, we only stand down until they are done.
    const manual = new Set<HTMLVideoElement>();
    let playing: HTMLVideoElement | null = null;
    let dwell: ReturnType<typeof setTimeout> | undefined;

    function render() {
      if (!toggle) return;
      toggle.hidden = false;
      toggle.dataset.playing = String(!stopped);
      icon?.setAttribute("d", stopped ? PLAY_ICON : PAUSE_ICON);
      if (label) {
        label.textContent = stopped ? "Play" : "Pause";
      }
    }

    /* One loop at a time, and only the one being looked at.

       `preload="none"` means play() is also the download, so an eight-tile
       gallery used to spend every byte it had on a single scroll — ~40 MB —
       and decode two or three 1080p streams at once on the way past. Both were
       the same bug: intersection is not attention. A tile now has to hold most
       of the frame and still be there 400 ms later before it costs anything,
       which is the difference between paying for what you watched and paying
       for what you scrolled past. */
    function settle() {
      const [best] = [...ratios]
        .filter(([, ratio]) => ratio >= 0.6)
        .sort((a, b) => b[1] - a[1]);
      const next = stopped || manual.size ? null : (best?.[0] ?? null);
      if (next === playing) return;
      playing?.pause();
      playing = next;
      clearTimeout(dwell);
      if (playing) {
        dwell = setTimeout(() => playing?.play().catch(() => {}), 400);
      }
    }

    toggle?.addEventListener("click", () => {
      stopped = !stopped;
      sessionStorage.setItem("uz-loops", stopped ? "stopped" : "playing");
      render();
      settle();
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const { target, intersectionRatio } of entries) {
          const video = target as HTMLVideoElement;
          ratios.set(video, intersectionRatio);
          // A tile the visitor started still stops when it leaves the frame.
          if (intersectionRatio === 0 && manual.has(video)) video.pause();
        }
        settle();
      },
      { threshold: [0, 0.3, 0.6, 0.9] },
    );

    for (const video of document.querySelectorAll<HTMLVideoElement>(
      "video[data-uz-loop]",
    )) {
      video.addEventListener("play", () => {
        if (video !== playing) manual.add(video);
      });
      video.addEventListener("pause", () => manual.delete(video));
      observer.observe(video);
    }

    render();
  }
</script>
