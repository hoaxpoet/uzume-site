---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import NotifyForm from "../components/NotifyForm.astro";
import Callout from "../components/Callout.astro";
import RequirementsList from "../components/RequirementsList.astro";
import VideoTile from "../components/VideoTile.astro";
import PresetCard from "../components/PresetCard.astro";
import { getCollection } from "astro:content";
import media from "../data/media.json";

const description =
  "A native macOS music visualizer that performs light to the music you are already playing.";

const REPO = "https://github.com/hoaxpoet/uzume";

// The manifest names the hero; W.3b's decision lives in the encoder, not here.
const hero = media.find((clip) => clip.role === "hero")!;
const presets = await getCollection("presets");
// Posters only — the hero already spends the page's motion budget. The two
// presets the hero does not show are the ones worth teasing.
const teasers = media
  .filter((clip) => clip.role === "gallery")
  .map((clip) => ({
    clip,
    preset: presets.find((entry) => entry.data.slug === clip.slug)!.data,
  }));

// Every fact here is checked against the app repo's README and PRODUCT_SPEC.
const requirements = [
  { term: "Mac", description: "Any Apple silicon Mac" },
  { term: "macOS", description: "macOS 14 Sonoma or later" },
  {
    term: "Music",
    description:
      "Local files, or whatever you already play — Uzume listens rather than taking over playback",
  },
  { term: "Licence", description: "Free and open source, MIT" },
];

const beats = [
  {
    title: "It listens to the whole playlist first",
    body: "Before a note is played, Uzume separates each track into stems and measures what is in them. The performance is prepared, not improvised at the last moment.",
  },
  {
    title: "Then it plans the session",
    body: "A deterministic planner decides which visual accompanies each track, where the transitions land, and how the arc moves across the playlist. Rules, reproducible — and you still don't know what you're about to see.",
  },
  {
    title: "And it keeps listening while you play",
    body: "Live analysis of the audio refines the plan as the music actually unfolds, so the performance answers the room rather than replaying a script.",
  },
];
---

<Base title="Uzume — a light in sound" description={description}>
  <Nav overlay />

  <main id="main">
    <section class="hero">
      {/* Murmuration, full-bleed. Decorative here and named on /gallery: the
          loop is the argument, not a second unlabelled tab stop. It carries no
          autoplay attribute, so under reduced motion — or on a phone, or on a
          metered connection — the poster stands and no video byte is fetched. */}
      <div class="hero__stage">
        <VideoTile
          bare
          title={hero.preset}
          poster={hero.posters.jpeg.url}
          sources={hero.renditions}
        />
      </div>

      <h1 class="hero__lockup">Uzume</h1>

      <div class="hero__copy">
        <p class="hero__claim">{description}</p>

        <ul class="hero__spec">
          <li>Apple silicon</li>
          <li>macOS 14 Sonoma or later</li>
          <li>Free and open source</li>
        </ul>

        <NotifyForm />

        <p class="hero__alt">
          Or <a href={REPO}>build it from source</a> — the repository is public
          today. There is no installable build yet; the public beta will be free
          and notarized when it arrives.
        </p>
      </div>
    </section>

    <section class="beats" aria-label="How it works">
      {beats.map(({ title, body }) => (
        <article class="beat">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </section>

    <section class="band" aria-label="What you need">
      <h2>What you need</h2>
      <RequirementsList items={requirements} />
    </section>

    <section class="band" aria-label="What Uzume asks of your Mac">
      <h2>What Uzume asks of your Mac</h2>
      <div class="trust">
        <Callout title="Everything happens on your Mac">
          Analysis and rendering run locally. Uzume has no account, sends no
          audio anywhere, and needs no network connection to perform.
        </Callout>
        <Callout
          tone="warning"
          title="System audio means the Screen Recording permission"
        >
          macOS files system-audio capture under Screen Recording. Uzume takes
          the audio and nothing else — not your screen, not your microphone.
          Playing local files needs no permission at all.
        </Callout>
        <Callout tone="success" title="Certified presets hold steady luminance">
          Every certified preset is tested for a bounded change in brightness
          from frame to frame, with beat-locked motion confined to parts of the
          frame rather than thrown across all of it. Reduced-motion settings are
          honoured throughout.
        </Callout>
      </div>
    </section>

    <section class="band teaser" aria-label="The gallery">
      <h2>See it perform</h2>
      <p class="teaser__lede">
        Certified presets, captured from the engine and published unedited. The
        gallery is where a merged preset ends up, with its author's name on it.
      </p>
      <div class="uz-preset-gallery">
        {teasers.map(({ clip, preset }) => (
          <PresetCard
            name={preset.name}
            author={preset.author}
            poster={clip.posters.jpeg.url}
          />
        ))}
      </div>
      <div class="teaser__actions">
        <Button variant="secondary" href="/gallery">
          See the gallery
        </Button>
      </div>
    </section>

    <section
      class="uz-contributor-invitation"
      aria-label="Contributing presets"
    >
      <div>
        <h2>Contributors write the repertoire</h2>
        <p>
          A preset is a Metal shader and a JSON file dropped into the
          repository. The ones that pass the gates will become part of what
          every listener sees, with their author's name on them.
        </p>
      </div>
      <Button variant="secondary" href={`${REPO}/blob/main/CONTRIBUTING.md`}>
        Write a preset
      </Button>
    </section>

    <section class="band myth" aria-label="The name">
      <h2>Uzume</h2>
      <p class="myth__pronunciation">oo-ZOO-meh</p>
      <p>
        In the <em>Kojiki</em>, the sun shuts herself in a cave and the world
        goes dark. A plan is made, a mirror is hung to catch light that does not
        yet exist, and Ame-no-Uzume stamps out a rhythm and dances until the
        gods roar. The sun opens the door to see what could possibly be worth
        that much noise.
      </p>
      <p>
        The performance is what brings the light out. That is the whole idea.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* No `vw` in the page frame. `50vw` counts the scrollbar and `50%` does not,
     so the two together produce a few pixels of real horizontal scroll on
     classic-scrollbar machines. main runs full width and each section centres
     its own column in percentages instead — which also means the hero is
     full-bleed by default rather than by escaping a constraint.

     The inline padding keeps the column exactly the width it was when main
     carried `max-width: 64rem` with its own gutters: 64rem less two gutters. */
  main {
    display: flow-root;
    /* The column every section centres, exactly the width it was when main
       carried `max-width: 64rem` with its own gutters. */
    --page-column: calc(64rem - 2 * var(--page-gutter));
  }

  /* The hero is excluded: it runs the full width and centres its own parts, so
     the veil under its copy can reach the window's edges. A percentage inside a
     child of a padded box resolves against that padded box, not the window, so
     a negative margin cannot undo the padding from within. */
  main > section:not(.hero) {
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
  }

  /* The footage bleeds the full width of the window and runs behind the
     header, which is transparent until the name has left it. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* The header is fixed and overlays this section, so the top padding owes
       it its own height on top of the section's own breathing room. */
    padding-block: calc(4.5rem + clamp(var(--space-8), 6vh, var(--space-16))) 0;
  }

  /* The footage is the upper band rather than the whole section. The flock
     drifts between 0.38 and 0.70 of the frame's height over the 30 s loop
     (measured, not guessed), and a centred copy column needs the lower half —
     footage stretched over the whole hero would put the flock behind the copy's
     veil and hide the one thing it is here to show. `object-position` centres
     the crop window on that travel, so the flock lands behind and just below
     the name. 40% horizontally only matters where the band is taller than 16:9
     and the crop turns horizontal, which is the phone case. */
  .hero__stage {
    position: absolute;
    inset: 0 0 auto;
    height: min(52svh, 30rem);
    overflow: hidden;
    z-index: -1;
    --uz-loop-position: 40% 58%;
    /* BRAND.md motion: the brand's authored movement is opening — content
       begins legible, darkness yields, light becomes visible. One deliberate
       reveal, on the hero only, never looping. Opacity only, no scale: this is
       the width of the window and a scale here is a zoom. `backwards` applies
       the from-state only during the delay and then releases, which is why,
       when the global rule in Base.astro collapses the duration under reduced
       motion, the field is simply already there. */
    animation: hero-opening var(--duration-deliberate) var(--ease-out) backwards;
  }

  @keyframes hero-opening {
    from {
      opacity: 0;
    }
  }

  /* The veil, sized from the footage rather than by eye. Alpha compositing is
     linear in relative luminance, so --color-canvas at alpha a over footage of
     luminance L lands the background at a·0.0037 + (1−a)·L, and a per-cell map
     of the loop's maximum luminance says what L is anywhere in the frame.

     0.46, flat, across the whole band. The crop that puts the flock under the
     name also puts the sky's brighter middle under the header — 0.256 at most
     over the loop, not the 0.090 the frame's own top would have given — so the
     header's strip cannot be lighter than the rest without failing. At 0.46 the
     name clears 3:1 (it is large text at 7rem), the header's links clear 5.1:1
     in --color-text-primary, and 54% of the cloud's light still reaches the
     reader through the transparent header, which is the point of it being
     transparent.

     The prose does not sit on 0.46; .hero__copy carries its own field below. */
  .hero__stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-canvas) 46%, transparent) 0,
      color-mix(in srgb, var(--color-canvas) 46%, transparent) 72%,
      var(--color-canvas) 100%
    );
  }

  /* The name, at hero scale, as live text rather than the outlined SVG — so it
     is the document's h1, it is selectable, and it is the same word in the same
     face as the header's, which is what makes the handoff read as one lockup
     moving rather than two lockups swapping.

     This element is also the timeline the header rides: anchoring to it rather
     than to a pixel offset keeps the timing right at every viewport, where its
     size and position both change. See Nav.astro. */
  .hero__lockup {
    margin: 0 0 auto;
    padding-inline: var(--page-gutter);
    font: var(--font-weight-semibold) clamp(4rem, 11vw, 7rem) /
      var(--leading-tight) var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    view-timeline: --uz-hero-lockup block;
  }

  /* The separate field BRAND.md offers as the alternative to putting copy on
     footage — here it is both: a veil, opaque enough to be a field. It fades in
     across its own top padding, where no text sits, and closes to the flat
     canvas the next section starts on so the hero has no visible bottom edge. */
  .hero__copy {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-16) var(--space-20);
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
    background: linear-gradient(
      to bottom,
      transparent 0,
      color-mix(in srgb, var(--color-canvas) 92%, transparent) var(--space-16),
      color-mix(in srgb, var(--color-canvas) 92%, transparent) 80%,
      var(--color-canvas) 100%
    );
  }

  /* The form leaves alignment to its container, and this container is centred. */
  .hero__copy :global(.notify) {
    align-items: center;
    text-align: center;
  }

  /* The one sentence that says what this is. It carries the display face but
     not the display size — the name is the headline now. */
  .hero__claim {
    max-width: 26ch;
    margin: 0;
    font: var(--font-weight-semibold) var(--text-3xl) / var(--leading-heading)
      var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  /* The eligibility gate at the moment of the decision, rather than a scroll
     away. The full list is still in "What you need". */
  .hero__spec {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .hero__alt {
    max-width: 44ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-tertiary);
    text-wrap: pretty;
  }

  .hero__alt a {
    color: var(--color-text-secondary);
  }

  .beats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-8);
    /* padding-block, never the shorthand — the shorthand resets the inline
       padding that centres every section's column. */
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-line);
  }

  .beat h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  .beat p {
    margin: 0;
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .band {
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-line);
  }

  .band > h2 {
    margin: 0 0 var(--space-6);
    font: var(--font-weight-semibold) var(--text-3xl) / var(--leading-tight)
      var(--font-display);
    letter-spacing: var(--tracking-display);
  }

  /* The brand's pronunciation lockup bakes this into vector letterforms, so it
     cannot be selected, resized with the reader's text settings, or corrected
     without regenerating the artwork. Live text instead: the heading above
     already renders in Alumni Sans, which is the wordmark's own face. */
  .myth__pronunciation {
    margin: 0 0 var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    /* Not uppercased, unlike the brand lockup: "oo-ZOO-meh" carries the stress
       in its capitals, and OO-ZOO-MEH throws that away. */
    letter-spacing: var(--tracking-label);
  }

  .myth h2 {
    margin-bottom: var(--space-2);
  }

  .myth p {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-6);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .trust {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .myth p:last-child {
    margin-bottom: 0;
    color: var(--color-text-primary);
  }

  .teaser__lede {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-8);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .teaser__actions {
    margin-top: var(--space-8);
  }

  /* The catalogue's invitation pattern sits inside the page rhythm. */
  /* The catalogue styles this as a card, with its own `padding` shorthand —
     which resets the inline padding that centres every other section. Centre
     it with margins instead, so it stays a card rather than becoming a
     full-bleed band with rounded corners at the window's edges. */
  .uz-contributor-invitation {
    margin-block: var(--space-16);
    margin-inline: auto;
    max-width: min(var(--page-column), calc(100% - 2 * var(--page-gutter)));
  }
</style>
