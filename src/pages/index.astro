---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import NotifyForm from "../components/NotifyForm.astro";
import Callout from "../components/Callout.astro";
import RequirementsList from "../components/RequirementsList.astro";
import VideoTile from "../components/VideoTile.astro";
import PresetCard from "../components/PresetCard.astro";
import { getCollection } from "astro:content";
import media from "../data/media.json";

const description =
  "A native macOS music visualizer that performs light to the music you are already playing.";

const REPO = "https://github.com/hoaxpoet/uzume";

// The manifest names the hero; W.3b's decision lives in the encoder, not here.
const hero = media.find((clip) => clip.role === "hero")!;
const presets = await getCollection("presets");
// Posters only — the hero already spends the page's motion budget. The presets
// the hero does not show are the ones worth teasing.
const teasers = media
  .filter((clip) => clip.role === "gallery")
  .map((clip) => ({
    clip,
    preset: presets.find((entry) => entry.data.slug === clip.slug)!.data,
  }));

// Every fact here is checked against the app repo's README and PRODUCT_SPEC.
const requirements = [
  { term: "Mac", description: "Any Apple silicon Mac" },
  { term: "macOS", description: "macOS 14 Sonoma or later" },
  {
    term: "Music",
    description:
      "Local files, or whatever you already play — Uzume listens rather than taking over playback",
  },
  { term: "Licence", description: "Free and open source, MIT" },
];

const beats = [
  {
    title: "It listens to the whole playlist first",
    body: "Before a note is played, Uzume separates each track into stems and measures what is in them. The performance is prepared, not improvised at the last moment.",
  },
  {
    title: "Then it plans the session",
    body: "A deterministic planner decides which visual accompanies each track, where the transitions land, and how the arc moves across the playlist. Rules, reproducible — and you still don't know what you're about to see.",
  },
  {
    title: "And it keeps listening while you play",
    body: "Live analysis of the audio refines the plan as the music actually unfolds, so the performance answers the room rather than replaying a script.",
  },
];
---

<Base title="Uzume — a native macOS music visualizer" description={description}>
  <Nav overlay />

  <main id="main">
    <section class="hero">
      {/* Murmuration, full-bleed. Decorative here and named on /gallery: the
          loop is the argument, not a second unlabelled tab stop. It carries no
          autoplay attribute, so under reduced motion — or on a phone, or on a
          metered connection — the poster stands and no video byte is fetched. */}
      <div class="hero__stage">
        <VideoTile
          bare
          title={hero.preset}
          poster={hero.posters.jpeg.url}
          sources={hero.renditions}
        />
      </div>

      <h1 class="hero__lockup">Uzume</h1>

      <div class="hero__copy">
        <p class="hero__claim">{description}</p>

        <NotifyForm />

        <p class="hero__alt">
          Or <a href={REPO}>build it from source</a> — the repository is public
          today. There is no installable build yet; the public beta will be free
          and notarized when it arrives.
        </p>

        {/* The footage was unnamed here, which left a visitor who sees only the
            poster — reduced motion, a phone, a metered connection — with no way
            to know it is engine output rather than a photograph, and no route
            to a version they can actually watch. BRAND.md asks for published
            footage to be real or clearly labelled; it was the first and not the
            second. True in every state: it says what the frame is, not what it
            is doing. */}
        <p class="hero__credit">
          {hero.preset}, rendered by Uzume. Every performance plays on
          demand <a href="/gallery">in the gallery</a>.
        </p>
      </div>
    </section>

    <section class="beats" aria-label="How it works">
      {beats.map(({ title, body }) => (
        <article class="beat">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </section>

    <section class="band" aria-label="What you need">
      <h2>What you need</h2>
      <RequirementsList items={requirements} />
    </section>

    <section class="band" aria-label="What Uzume asks of your Mac">
      <h2>What Uzume asks of your Mac</h2>
      <div class="trust">
        <Callout title="Everything happens on your Mac">
          Analysis and rendering run locally. Uzume has no account, sends no
          audio anywhere, and needs no network connection to perform.
        </Callout>
        <Callout
          tone="warning"
          title="System audio means the Screen Recording permission"
        >
          macOS files system-audio capture under Screen Recording. Uzume takes
          the audio and nothing else — not your screen, not your microphone.
          Playing local files needs no permission at all.
        </Callout>
        <Callout tone="success" title="Scenes are tested for steady luminance">
          Every scene is tested for a bounded change in brightness
          from frame to frame, with beat-locked motion confined to parts of the
          frame rather than thrown across all of it. Reduced-motion settings are
          honoured throughout.
        </Callout>
      </div>
    </section>

    <section class="band teaser" aria-label="The gallery">
      <h2>See it perform</h2>
      <p class="teaser__lede">
        Scenes recorded from Uzume and published unedited. The gallery is
        where a merged scene ends up, with its author's name on it.
      </p>
      <div class="uz-preset-gallery">
        {teasers.map(({ clip, preset }) => (
          <PresetCard
            name={preset.name}
            author={preset.author}
            poster={clip.posters.jpeg.url}
          />
        ))}
      </div>
      <div class="teaser__actions">
        <Button variant="secondary" href="/gallery">
          See the gallery
        </Button>
      </div>
    </section>

    <section
      class="uz-contributor-invitation"
      aria-label="Contributing scenes"
    >
      <div>
        <h2>Contributors write the scenes</h2>
        <p>
          Scenes are written by people, not shipped by a company. Write one,
          and if it makes it in it becomes part of what every listener sees,
          with your name on it.
        </p>
      </div>
      <Button variant="secondary" href={`${REPO}/blob/main/CONTRIBUTING.md`}>
        Write a scene
      </Button>
    </section>

    <section class="band myth" aria-label="The name">
      <h2>The name</h2>
      <p class="myth__pronunciation">oo-ZOO-meh</p>
      <p>
        In the <em>Kojiki</em>, the sun shuts herself in a cave and the world
        goes dark. A plan is made, a mirror is hung to catch light that does not
        yet exist, and Ame-no-Uzume stamps out a rhythm and dances until the
        gods roar. The sun opens the door to see what could possibly be worth
        that much noise.
      </p>
      <p>
        The performance is what brings the light out. That is the whole idea.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* No `vw` in the page frame. `50vw` counts the scrollbar and `50%` does not,
     so the two together produce a few pixels of real horizontal scroll on
     classic-scrollbar machines. main runs full width and each section centres
     its own column in percentages instead — which also means the hero is
     full-bleed by default rather than by escaping a constraint.

     The inline padding keeps the column exactly the width it was when main
     carried `max-width: 64rem` with its own gutters: 64rem less two gutters. */
  main {
    display: flow-root;
    /* The column every section centres, exactly the width it was when main
       carried `max-width: 64rem` with its own gutters. */
    --page-column: calc(64rem - 2 * var(--page-gutter));
  }

  /* Two exclusions.

     The hero runs the full width and centres its own parts, so the footage can
     reach the window's edges.

     The contributor invitation is a catalogue card with its own `padding`
     shorthand and its own `max-width` below. Left in this rule it got padded
     twice: a percentage padding resolves against the PARENT's width, not the
     element's own, so the centring padding was computed as if the card were
     still full-bleed — 248.5px of padding each side of a 928px card, and its
     body set at 33 characters. */
  main > section:not(.hero, .uz-contributor-invitation) {
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
  }

  /* The footage bleeds the full width of the window and runs behind the
     header, which is transparent until the name has left it.

     Two rows, and the footage owns the first one outright. The copy used to be
     laid over the footage and held off it by a veil, which coupled three things
     that have no business being coupled — how tall the hero is, how tall the
     copy happens to be, and where in the frame the flock sits. Every time the
     copy changed length the swarm got clipped, and the fix each time was more
     hero height. It is a row now: the band cannot be entered by the copy, so
     the flock is safe at every size and the hero is back to one screen. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    text-align: center;
  }

  /* 16:9 until it would be taller than the band's ceiling, so the crop stays
     in the regime where `object-position` has room to work and the flock is
     inside the band at every width. The ceiling is set so that the band and the
     copy together come to about one screen on an ordinary laptop: the hero is
     as tall as its two parts need and not a pixel more. */
  .hero__stage {
    grid-area: 1 / 1;
    /* Not optional: the veil below is absolutely positioned, and without a
       positioned stage it resolved against .hero instead — covering the whole
       section, swallowing every click and text selection in the copy beneath
       it, and stretching the gradient over 900px so the band had no closing
       ramp at all. */
    position: relative;
    height: min(25rem, 56.25vw);
    overflow: hidden;
    /* The flock drifts between 0.38 and 0.70 of the frame's height over the
       30 s loop (measured, not guessed), which is 259px of frame at a 1440px
       window. 55% centres that travel in the band's clear part — between the
       header's own height at the top and the veil's closing ramp at the
       bottom — so no part of the swarm is ever inside either. 40% horizontally keeps it in frame where
       the crop turns horizontal, which is the narrow case. */
    --uz-loop-position: 40% 70%;
    /* BRAND.md motion: the brand's authored movement is opening — content
       begins legible, darkness yields, light becomes visible. One deliberate
       reveal, on the hero only, never looping. Opacity only, no scale: this is
       the width of the window and a scale here is a zoom. `backwards` applies
       the from-state only during the delay and then releases, which is why,
       when the global rule in Base.astro collapses the duration under reduced
       motion, the field is simply already there. */
    animation: hero-opening var(--duration-deliberate) var(--ease-out) backwards;
  }

  @keyframes hero-opening {
    from {
      opacity: 0;
    }
  }

  /* No veil over the footage at all any more, only a corner.

     Two things sit on the sky and they are answered separately, because a veil
     across the whole band was paying for both everywhere.

     The header's links are body text at 16px with no exemption, so they keep a
     scrim — but only in the corner they occupy. The radial reaches x=712 and
     is effectively spent by the time it meets the flock's tail.

     The name is answered by a halo on the glyphs themselves (see
     .hero__lockup), which puts the dark exactly where the letterforms are and
     nowhere else. So the sky keeps 100% of its light everywhere but that one
     corner — against 54% when this was a flat band.

     The linear layer closes to canvas at the foot so the band meets the copy
     without an edge, and before that it takes 8% off the lower sky.

     That 8% is Matt's choice from a measured trade, and the trade is worth
     recording because it has no clever answer. The lighter band he saw between
     the flock and the foot of the hero is the sky's own downward brightening —
     the frame runs 0.080 at the top to 0.448 at the bottom — so anything that
     removes the band darkens the sky. They are the same knob. Sampled across
     five frames of the loop:

       no compensation   sky L* 58.6, band +5.3   brightest, band visible
       8%   (this)       sky L* 57.1, band +3.2   gives up 1.5, cuts it ~40%
       16%               sky L* 55.6, band +0.9   band gone, too dark

     Twenty combinations of `object-position` and compensation were tested and
     none reaches L* 57 with the band gone; a flatter crop only shifts the curve.
     The real fix is footage whose sky does not brighten toward the bottom, which
     is what W.3c is for — Cymatic Resonance and Dragon Bloom have no sky at all.
     Until then this is the agreed middle, not a solution. */
  .hero__stage::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Decoration. It must never be the thing a click or a drag lands on. */
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 50% 80% at 100% 0%,
        color-mix(in srgb, var(--color-canvas) 68%, transparent) 0%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--color-canvas) 4%, transparent) 20%,
        color-mix(in srgb, var(--color-canvas) 8%, transparent) 40%,
        color-mix(in srgb, var(--color-canvas) 8%, transparent) 78%,
        color-mix(in srgb, var(--color-canvas) 16%, transparent) 82%,
        color-mix(in srgb, var(--color-canvas) 32%, transparent) 86%,
        color-mix(in srgb, var(--color-canvas) 55%, transparent) 90%,
        color-mix(in srgb, var(--color-canvas) 78%, transparent) 94%,
        color-mix(in srgb, var(--color-canvas) 94%, transparent) 97%,
        var(--color-canvas) 100%
      );
  }

  /* The name, at hero scale, as live text rather than the outlined SVG — so it
     is the document's h1, it is selectable, and it is the same word in the same
     face as the header's, which is what makes the handoff read as one lockup
     moving rather than two lockups swapping.

     It shares the band's grid cell rather than sitting above or below it, so it
     is centred on the swarm at every size. The top padding is the fixed
     header's own height: the box is what gets centred, so the padding keeps the
     word clear of the header on short bands without moving it on tall ones.

     This element is also the timeline the header rides: anchoring to it rather
     than to a pixel offset keeps the timing right at every viewport, where its
     size and position both change. See Nav.astro. */
  .hero__lockup {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: center;
    z-index: 1;
    margin: 0;
    padding: 4.5rem var(--page-gutter) 0;
    font: var(--font-weight-semibold) clamp(4rem, 11vw, 7rem) /
      var(--leading-tight) var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    /* The name's own scrim, shaped like the name. A field across the band had
       to darken the whole sky to seat one word; a halo puts the dark only where
       the letterforms are, so it buys the same legibility and costs the image
       nothing. Sized in em so it tracks the clamp rather than a fixed pixel
       radius, and drawn in --color-canvas so it reads as the dark the letters
       sit in rather than as a drop shadow.

       WCAG 1.4.3 exempts a brand name from contrast entirely, so this is a
       legibility decision rather than a compliance one; measured at the glyph
       edges it lands around 5:1 against a 3:1 bar for large text. */
    text-shadow:
      0 0 0.05em color-mix(in srgb, var(--color-canvas) 70%, transparent),
      0 0 0.18em color-mix(in srgb, var(--color-canvas) 50%, transparent),
      0 0 0.55em color-mix(in srgb, var(--color-canvas) 32%, transparent);
    view-timeline: --uz-hero-lockup block;
  }

  /* The second row. It sits below the band rather than over it, so it needs
     no veil — the band's own gradient has already closed to canvas by the time
     this starts. `1fr` lets it absorb whatever is left of the first screen. */
  .hero__copy {
    grid-area: 2 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-8);
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
  }

  /* The form leaves alignment to its container, and this container is centred.
     It also gets far more room than the rhythm gives anything else here: it is
     the page's primary action, and the only thing in the hero a visitor can
     actually complete today. Space is what makes it read that way — the space
     above and below it is what separates the claim from the build-from-source
     sentence, so the two asks are not one paragraph of small print. */
  .hero__copy :global(.notify) {
    align-items: center;
    text-align: center;
    margin-block: var(--space-12);
    /* Wider than the component's own default, which was sized for a narrow
       column. This is the page's primary action and it is allowed to look it. */
    width: min(38rem, 100%);
  }

  /* The one sentence that says what this is. It carries the display face but
     not the display size — the name is the headline now. */
  .hero__claim {
    max-width: 44rem;
    margin: 0;
    font: var(--font-weight-semibold) var(--text-3xl) / var(--leading-heading)
      var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .hero__alt {
    max-width: 42rem;
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-tertiary);
    text-wrap: pretty;
  }

  .hero__alt a {
    color: var(--color-text-secondary);
  }

  /* A credit, so it sits below the asks rather than competing with them. */
  .hero__credit {
    max-width: 42rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-tertiary);
    text-wrap: pretty;
  }

  .hero__credit a {
    color: var(--color-text-secondary);
  }

  .beats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-8);
    /* padding-block, never the shorthand — the shorthand resets the inline
       padding that centres every section's column. */
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-line);
  }

  .beat h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  .beat p {
    margin: 0;
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .band {
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-line);
  }

  .band > h2 {
    margin: 0 0 var(--space-6);
    font: var(--font-weight-semibold) var(--text-3xl) / var(--leading-tight)
      var(--font-display);
    letter-spacing: var(--tracking-display);
  }

  /* The brand's pronunciation lockup bakes this into vector letterforms, so it
     cannot be selected, resized with the reader's text settings, or corrected
     without regenerating the artwork. Live text instead: the heading above
     already renders in Alumni Sans, which is the wordmark's own face. */
  .myth__pronunciation {
    margin: 0 0 var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    /* Not uppercased, unlike the brand lockup: "oo-ZOO-meh" carries the stress
       in its capitals, and OO-ZOO-MEH throws that away. */
    letter-spacing: var(--tracking-label);
  }

  .myth h2 {
    margin-bottom: var(--space-2);
  }

  .myth p {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-6);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .trust {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .myth p:last-child {
    margin-bottom: 0;
    color: var(--color-text-primary);
  }

  .teaser__lede {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-8);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .teaser__actions {
    margin-top: var(--space-8);
  }

  /* The catalogue's invitation pattern sits inside the page rhythm. */
  /* The catalogue styles this as a card. It centres itself with margins and is
     excluded from the frame rule above, so its own padding is the only padding
     it gets. */
  .uz-contributor-invitation {
    margin-block: var(--space-16);
    margin-inline: auto;
    max-width: min(var(--page-column), calc(100% - 2 * var(--page-gutter)));
  }
</style>
