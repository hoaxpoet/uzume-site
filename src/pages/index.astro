---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import NotifyForm from "../components/NotifyForm.astro";
import Callout from "../components/Callout.astro";
import RequirementsList from "../components/RequirementsList.astro";
import VideoTile from "../components/VideoTile.astro";
import PresetCard from "../components/PresetCard.astro";
import { getCollection } from "astro:content";
import media from "../data/media.json";

const description =
  "A native macOS music visualizer that performs light to the music you are already playing.";

const REPO = "https://github.com/hoaxpoet/uzume";

// The manifest names the hero; W.3b's decision lives in the encoder, not here.
const hero = media.find((clip) => clip.role === "hero")!;
const presets = await getCollection("presets");
// Posters only — the hero already spends the page's motion budget. The two
// presets the hero does not show are the ones worth teasing.
const teasers = media
  .filter((clip) => clip.role === "gallery")
  .map((clip) => ({
    clip,
    preset: presets.find((entry) => entry.data.slug === clip.slug)!.data,
  }));

// Every fact here is checked against the app repo's README and PRODUCT_SPEC.
const requirements = [
  { term: "Mac", description: "Any Apple silicon Mac" },
  { term: "macOS", description: "macOS 14 Sonoma or later" },
  {
    term: "Music",
    description:
      "Local files, or whatever you already play — Uzume listens rather than taking over playback",
  },
  { term: "Licence", description: "Free and open source, MIT" },
];

const beats = [
  {
    title: "It listens to the whole playlist first",
    body: "Before a note is played, Uzume separates each track into stems and measures what is in them. The performance is prepared, not improvised at the last moment.",
  },
  {
    title: "Then it plans the session",
    body: "A deterministic planner decides which visual accompanies each track, where the transitions land, and how the arc moves across the playlist. Rules, reproducible — and you still don't know what you're about to see.",
  },
  {
    title: "And it keeps listening while you play",
    body: "Live analysis of the audio refines the plan as the music actually unfolds, so the performance answers the room rather than replaying a script.",
  },
];
---

<Base title="Uzume — a light in sound" description={description}>
  <Nav handOffBrand />

  <main id="main">
    <section class="hero">
      {/* Murmuration, full-bleed. Decorative here and named on /gallery: the
          loop is the argument, not a second unlabelled tab stop. It carries no
          autoplay attribute, so under reduced motion — or on a phone, or on a
          metered connection — the poster simply stands and no video byte is
          fetched. */}
      <div class="hero__stage">
        <VideoTile
          bare
          title={hero.preset}
          poster={hero.posters.jpeg.url}
          sources={hero.renditions}
        />
      </div>

      <div class="hero__field">
        <img
          class="hero__icon"
          src="/uzume-icon.png"
          alt=""
          width="256"
          height="256"
          fetchpriority="high"
        />
        <h1 class="hero__lockup">
          <img
            class="hero__wordmark"
            src="/uzume-wordmark.svg"
            alt="Uzume"
            width="316"
            height="160"
          />
        </h1>
      </div>

      <div class="hero__copy">
        <blockquote class="hero__tagline">
          <p>A light in sound, a sound-like power in light.</p>
          <cite>
            Coleridge, <em>The Eolian Harp</em>, 1795
          </cite>
        </blockquote>
        <p class="hero__lede">{description}</p>
        <p class="hero__note">
          Uzume is open source and buildable today. There is no installable
          build yet — the public beta will be free and notarized when it
          arrives.
        </p>
        <NotifyForm />
        <div class="hero__actions">
          <Button variant="secondary" href={REPO}>
            On GitHub today — build from source
          </Button>
        </div>
        <p class="hero__requirements">Apple silicon · macOS 14+ · free, MIT</p>
      </div>
    </section>

    <section class="beats" aria-label="How it works">
      {beats.map(({ title, body }) => (
        <article class="beat">
          <h2>{title}</h2>
          <p>{body}</p>
        </article>
      ))}
    </section>

    <section class="band" aria-label="What you need">
      <h2>What you need</h2>
      <RequirementsList items={requirements} />
    </section>

    <section class="band" aria-label="What Uzume asks of your Mac">
      <h2>What Uzume asks of your Mac</h2>
      <div class="trust">
        <Callout title="Everything happens on your Mac">
          Analysis and rendering run locally. Uzume has no account, sends no
          audio anywhere, and needs no network connection to perform.
        </Callout>
        <Callout
          tone="warning"
          title="System audio means the Screen Recording permission"
        >
          macOS files system-audio capture under Screen Recording. Uzume takes
          the audio and nothing else — not your screen, not your microphone.
          Playing local files needs no permission at all.
        </Callout>
        <Callout tone="success" title="Certified presets hold steady luminance">
          Every certified preset is tested for a bounded change in brightness
          from frame to frame, with beat-locked motion confined to parts of the
          frame rather than thrown across all of it. Reduced-motion settings are
          honoured throughout.
        </Callout>
      </div>
    </section>

    <section class="band teaser" aria-label="The gallery">
      <h2>See it perform</h2>
      <p class="teaser__lede">
        Certified presets, captured from the engine and published unedited. The
        gallery is where a merged preset ends up, with its author's name on it.
      </p>
      <div class="uz-preset-gallery">
        {teasers.map(({ clip, preset }) => (
          <PresetCard
            name={preset.name}
            author={preset.author}
            poster={clip.posters.jpeg.url}
          />
        ))}
      </div>
      <div class="teaser__actions">
        <Button variant="secondary" href="/gallery">
          See the gallery
        </Button>
      </div>
    </section>

    <section
      class="uz-contributor-invitation"
      aria-label="Contributing presets"
    >
      <div>
        <h2>Contributors write the repertoire</h2>
        <p>
          A preset is a Metal shader and a JSON file dropped into the
          repository. The ones that pass the gates will become part of what
          every listener sees, with their author's name on them.
        </p>
      </div>
      <Button variant="secondary" href={`${REPO}/blob/main/CONTRIBUTING.md`}>
        Write a preset
      </Button>
    </section>

    <section class="band myth" aria-label="The name">
      <h2>Uzume</h2>
      <p class="myth__pronunciation">oo-ZOO-meh</p>
      <p>
        In the <em>Kojiki</em>, the sun shuts herself in a cave and the world
        goes dark. A plan is made, a mirror is hung to catch light that does not
        yet exist, and Ame-no-Uzume stamps out a rhythm and dances until the
        gods roar. The sun opens the door to see what could possibly be worth
        that much noise.
      </p>
      <p>
        The performance is what brings the light out. That is the whole idea.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .hero {
    position: relative;
    isolation: isolate;
    /* The opening light is wider than the hero; clip only the axis that would
       otherwise scroll the page. `clip` leaves the other axis visible in a way
       `hidden` would not. */
    overflow-x: clip;
    /* Full-bleed out of main's measure: the footage is the argument, and it
       makes it at the width of the window (plan §5, decision 2A). */
    margin-inline: calc(50% - 50vw);
    padding-inline: var(--page-gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    min-height: min(92svh, 56rem);
    padding-block: clamp(var(--space-8), 5vh, var(--space-12)) var(--space-16);
    text-align: center;
  }

  /* Murmuration, behind everything — but cropped to its subject. The flock
     sits at 63% of the frame's height, and the hero's copy needs the bottom
     half of the section, so footage stretched over the whole hero would hide
     the very thing it is here to show. The stage is the upper band instead,
     and `object-position` puts the flock inside it. Full-bleed still: the
     footage runs the width of the window. */
  .hero__stage {
    position: absolute;
    inset: 0 0 auto;
    height: min(52svh, 30rem);
    overflow: hidden;
    z-index: 0;
    /* Over the 30 s loop the flock drifts between 0.38 and 0.70 of the frame's
       height (measured, not guessed). 58% centres the crop window on 0.54, so
       the flock is inside it for the whole loop at every stage height this
       band takes.
       Horizontally, 40% rather than the centre: at desktop widths the frame
       fills the band and the value is inert, and on a phone — where the band
       is taller than 16:9 and the crop is horizontal — it keeps the flock,
       which sits left of centre, inside the window. */
    --uz-loop-position: 40% 58%;
  }

  /* The scrim. BRAND.md asks for one wherever copy crosses a busy region, and
     a dusk sky under white type is the case it names. Sized from the footage
     rather than by eye: over the whole 30 s loop the brightest local patch
     reaches a relative luminance of 0.447 (0.412 within the copy column), so —
     alpha compositing being linear in relative luminance — a scrim of
     --color-canvas at alpha a lands the background at a·0.0037 + (1-a)·0.447.

       0.86 across the top 4.5rem   the navigation's own height. Its links are
                                    --color-text-secondary: 5.4:1 there.
       0.50 from 9rem down          the lockup band. The wordmark is #F4F6F1
                                    on 0.226 — 3.5:1, clear of the 3:1 that
                                    WCAG 1.4.11 asks of meaningful graphics —
                                    and three fifths of the footage survives.

     The prose does not sit on 0.50; .hero__copy carries its own field below. */
  .hero__stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-canvas) 86%, transparent) 0,
      color-mix(in srgb, var(--color-canvas) 86%, transparent) 4.5rem,
      color-mix(in srgb, var(--color-canvas) 50%, transparent) 9rem,
      color-mix(in srgb, var(--color-canvas) 50%, transparent) 72%,
      var(--color-canvas) 100%
    );
  }

  /* Everything the reader looks at sits above the stage and above the opening
     light; flex children need a position to take a z-index at all. */
  .hero > :not(.hero__stage) {
    position: relative;
    z-index: 2;
  }

  .hero__field {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  /* The separate field BRAND.md offers as the alternative to putting copy on
     footage — here it is both: a scrim, opaque enough to be a field. At 92%
     over the scrimmed footage the background reaches a relative luminance of
     0.021, which puts the weakest text on the page (--color-text-tertiary, the
     Coleridge citation and the requirements line) at 6.1:1. It fades in across
     its own top padding, where no text sits, and closes to the flat canvas the
     next section starts on so the hero has no visible bottom edge. */
  .hero__copy {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    margin-inline: calc(-1 * var(--page-gutter));
    padding: var(--space-16) var(--page-gutter) var(--space-8);
    background: linear-gradient(
      to bottom,
      transparent 0,
      color-mix(in srgb, var(--color-canvas) 92%, transparent) var(--space-16),
      color-mix(in srgb, var(--color-canvas) 92%, transparent) 80%,
      var(--color-canvas) 100%
    );
  }

  /* BRAND.md motion: the brand's authored movement is opening — content begins
     legible, darkness yields, light becomes visible. One deliberate reveal, on
     the hero only, never looping. `backwards` applies the from-state only
     during the delay and then releases, so the resting state is the rule's own
     opacity — which is also why, when the global rule in Base.astro collapses
     the duration under reduced motion, the light is simply already there. */
  .hero::before {
    content: "";
    position: absolute;
    /* Above the footage and its scrim, below the copy. */
    z-index: 1;
    inset: -20% -10% auto;
    aspect-ratio: 2 / 1;
    background: radial-gradient(
      ellipse at 50% 40%,
      var(--color-accent-subtle) 0%,
      transparent 70%
    );
    opacity: 0.55;
    animation: hero-opening var(--duration-deliberate) var(--ease-out) backwards;
  }

  @keyframes hero-opening {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  /* BRAND.md: the full icon composition at 64px or larger, with clear space of
     at least an eighth of its width. Empty alt — the wordmark below already
     names the product, and "Uzume Uzume" is what a reader would otherwise hear. */
  .hero__icon {
    width: min(6rem, 22vw);
    height: auto;
    border-radius: 22.37%;
  }

  .hero__lockup {
    margin: 0;
    /* Drives the header handoff — see Nav.astro. Anchoring to this element
       rather than to pixel offsets keeps the timing correct at every viewport,
       where the lockup's size and position both change. */
    view-timeline: --uz-hero-lockup block;
  }

  .hero__wordmark {
    display: block;
    width: min(17rem, 60vw);
    height: auto;
  }

  /* Coleridge signs the lockup; he does not headline it. The poem is 231 years
     old and does not say what the product is, so it sits at caption scale
     directly under the wordmark and hands the display voice to the lede. */
  .hero__tagline {
    margin: 0;
    max-width: 30rem;
  }

  .hero__tagline p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: balance;
  }

  .hero__tagline cite {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-style: normal;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-tertiary);
  }

  /* The one sentence that says what this is, in the brand's own display face. */
  .hero__lede {
    max-width: 28ch;
    margin: 0;
    font: var(--font-weight-semibold) var(--text-3xl) / var(--leading-heading)
      var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .hero__actions {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .hero__note {
    max-width: 38rem;
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* The eligibility gate, at the moment of the decision rather than 1,300px
     below it. The full list is still in "What you need". */
  .hero__requirements {
    margin: 0;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-tertiary);
  }

  .beats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-8);
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-line);
  }

  .beat h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  .beat p {
    margin: 0;
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .band {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-line);
  }

  .band > h2 {
    margin: 0 0 var(--space-6);
    font: var(--font-weight-semibold) var(--text-3xl) / var(--leading-tight)
      var(--font-display);
    letter-spacing: var(--tracking-display);
  }

  /* The brand's pronunciation lockup bakes this into vector letterforms, so it
     cannot be selected, resized with the reader's text settings, or corrected
     without regenerating the artwork. Live text instead: the heading above
     already renders in Alumni Sans, which is the wordmark's own face. */
  .myth__pronunciation {
    margin: 0 0 var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    /* Not uppercased, unlike the brand lockup: "oo-ZOO-meh" carries the stress
       in its capitals, and OO-ZOO-MEH throws that away. */
    letter-spacing: var(--tracking-label);
  }

  .myth h2 {
    margin-bottom: var(--space-2);
  }

  .myth p {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-6);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .trust {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .myth p:last-child {
    margin-bottom: 0;
    color: var(--color-text-primary);
  }

  .teaser__lede {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-8);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .teaser__actions {
    margin-top: var(--space-8);
  }

  /* The catalogue's invitation pattern sits inside the page rhythm. */
  .uz-contributor-invitation {
    margin: var(--space-16) 0;
  }
</style>
