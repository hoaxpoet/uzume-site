---
// The landing page. Built and judged as /mock through W.5a, then promoted.
//
// Architecture is Matt's: the hero is the name and its sentence over the
// footage, and the ask is its own section beneath rather than a fourth thing
// stacked inside the hero. Nothing here is invented — the two application
// captures render as labelled gaps, because PRODUCT.md says no application
// assets exist in this repo and must not be fabricated.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import NotifyForm from "../components/NotifyForm.astro";
import VideoTile from "../components/VideoTile.astro";
import PresetCard from "../components/PresetCard.astro";
import { getCollection } from "astro:content";
import media from "../data/media.json";

const REPO = "https://github.com/hoaxpoet/uzume";

// Matt's line, and the page's spine: listens, analyzes, accompanies. The
// previous claim led on stem separation, which is expensive and largely
// unavailable on the streaming path — where most visitors will be — so it was
// false for the majority case. Musicality is the umbrella that is true on both
// paths.
const claim =
  "A music visualizer for macOS that listens, analyzes, and accompanies.";

const hero = media.find((clip) => clip.role === "hero")!;
const presets = await getCollection("presets");
const teasers = media
  .filter((clip) => clip.role === "gallery")
  .map((clip) => ({
    clip,
    preset: presets.find((entry) => entry.data.slug === clip.slug)!.data,
  }));

// Evidence of accompaniment, shown rather than asserted — and pulled OUT of
// the featured row below, so the page never shows the same clip twice.
const accompanist = teasers.find(({ clip }) => clip.slug === "skein")!;
const featured = teasers.filter(({ clip }) => clip.slug !== "skein");

// Three beats, each with its own evidence. Two await real captures; the third
// is a preset already published. Rows, not a three-up grid — the grid was the
// same shape as the band that followed it, which made the page read as two
// helpings of the same thing.
const beats = [
  {
    title: "It listens",
    // "a streaming app" was the only way this sentence referred to Apple Music
    // and Spotify, and they were named nowhere on the site except inside the
    // alt text of the screenshot below — where a reader looking for exactly
    // that answer will not find them, and where a search engine weighs them at
    // close to nothing. The capture itself is the source: the application's own
    // picker names all three.
    body: "With local files, Uzume hears the whole playlist before it plays a note. With anything else — Apple Music, Spotify, a browser tab — it listens to what is actually coming out of your Mac.",
    shot: {
      avif: "/app-choose-source.avif",
      jpeg: "/app-choose-source.jpg",
      width: 896,
      height: 689,
      alt: "Uzume asking where the music comes from: Apple Music, Spotify, or local files, under a line reading “With Apple Music or Spotify, you press play and Uzume listens. Local files it plays for you.”",
    },
  },
  {
    title: "It analyzes",
    body: "It pulls the music apart — drums, bass, voice, everything else — and follows each one separately, along with where the beats fall and how the harmony moves. On a local file that starts immediately; from a streaming app it takes ten or fifteen seconds, and works from the mix until then.",
    shot: {
      avif: "/app-preparing.avif",
      jpeg: "/app-preparing.jpg",
      width: 896,
      height: 560,
      alt: "Uzume working through a queue of three local files before playback: the first reads “Separating stems”, the two below it are waiting.",
    },
  },
  {
    title: "It accompanies",
    body: "Scenes are written to answer particular parts of it — bass drives one thing, the vocal line another — so what you see follows the music instead of twitching at its volume.",
  },
];

// What the page already says, in the form a search engine and an answer engine
// can read without parsing prose. Every field is checked against PRODUCT.md:
// there is deliberately no `offers`, `downloadUrl` or `softwareVersion`, because
// each of those asserts an installable artifact and none exists yet. Add them in
// W.7, when a signed, notarized build is on GitHub Releases and the claim is
// true. `isAccessibleForFree` is the claim that IS true today — the source is
// public and MIT-licensed.
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Uzume",
  alternateName: "Uzume music visualizer",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 14 or later, Apple silicon",
  description: claim,
  url: "https://uzume.io/",
  image: "https://uzume.io/uzume-social.png",
  isAccessibleForFree: true,
  license: "https://opensource.org/licenses/MIT",
  codeRepository: REPO,
  author: { "@type": "Person", name: "hoaxpoet" },
};
---

<Base
  title="Uzume — a music visualizer for macOS"
  description={claim}
  schema={schema}
>
  <Nav overlay />

  <main id="main">
    <section class="hero">
      <div class="hero__stage">
        <VideoTile
          bare
          title={hero.preset}
          poster={hero.posters.jpeg.url}
          posterAvif={hero.posters.avif?.url}
          thumb={hero.thumbs.jpeg.url}
          thumbAvif={hero.thumbs.avif?.url}
          sources={hero.renditions}
        />
      </div>

      <div class="hero__lockup">
        <h1>Uzume</h1>
        <p class="hero__claim">{claim}</p>
      </div>
    </section>

    {/* The ask, on its own, under the hero rather than inside it. The specs
        sit above the field because they are what the visitor is deciding
        against: what it is, and whether it will run on the machine they are
        reading this on. */}
    <section class="signup">
      {/* The icon earns its place here rather than in the closing section.
          This is the line that means "a Mac app you will have in your Dock",
          which is what an app icon says; beside the myth it would have invited
          the Negative Dance reading BRAND.md archived, since First Opening is
          shadow and light rather than a figure.

          64px is the floor BRAND.md sets for the full composition — the 16-32px
          artwork is a separate art-directed crop, not this one scaled down —
          and the gap clears the required one-eighth. Decorative: the sentence
          beside it already carries the meaning.

          The file is brand/icon/Uzume.iconset/icon_128x128.png copied
          unmodified, which is the production artwork at exactly the size a
          64px slot needs on a 2x display. The 256px uzume-icon.png it replaced
          shipped 69.5 KB to draw 64 points. */}
      <div class="signup__what">
        <img
          class="signup__icon"
          src="/uzume-icon-128.png"
          alt=""
          width="128"
          height="128"
        />
        <p class="signup__specs">
          No build to download yet: the source is public and you can{" "}
          <a href={REPO}>build it today</a>. The beta will be free and open
          source, MIT-licensed, for Apple silicon Macs on macOS 14 or later.
        </p>
      </div>
      {/* No `terms` override. This page and /gallery mount the same component
          and must make the same promise — and the success panel the form swaps
          in on submit renders the component's default regardless, so an
          override here only changes the promise up to the moment it is
          accepted. */}
      <NotifyForm label="Email me when the public beta is ready" />
    </section>

    <section class="band beats-band">
      {/* Rows, not a three-up grid. Each claim sits beside the thing that
          proves it, which is also what stops this band and the one after it
          reading as two helpings of the same layout. */}
      <h2>What it does</h2>
      <p class="lede">
        Uzume — oo-ZOO-meh — is named for a dancer who drew the light out of a
        cave. What the app does is less mythic: it listens to your music, works
        out what is in it, and draws something to go with it.
      </p>
      <div class="beats">
        {beats.map(({ title, body, shot }) => (
          <article class="beat">
            <div class="beat__copy">
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
            <div class="beat__evidence">
              {/* Real captures of the running application, not mockups —
                  PRODUCT.md is explicit that this repo must not fabricate them.
                  AVIF with a JPEG behind it, and both dimensions declared so
                  the row is reserved before the image arrives. */}
              {shot ? (
                <picture>
                  <source srcset={shot.avif} type="image/avif" />
                  <img
                    class="shot"
                    src={shot.jpeg}
                    alt={shot.alt}
                    width={shot.width}
                    height={shot.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              ) : (
                <VideoTile
                  title={accompanist.preset.name}
                  meta={`${accompanist.preset.author} · ${accompanist.preset.family}`}
                  poster={accompanist.clip.posters.jpeg.url}
                  posterAvif={accompanist.clip.posters.avif?.url}
                  thumb={accompanist.clip.thumbs.jpeg.url}
                  thumbAvif={accompanist.clip.thumbs.avif?.url}
                  sources={accompanist.clip.renditions}
                />
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Was two sections, in the wrong order: seven presets shown, then a
        section explaining what a preset is. The definition comes first now,
        and the people who write them stay with the thing they write. */}
    <section class="band">
      <h2>Featured scenes</h2>
      <p class="lede">
        A scene is one way of drawing the music — its own shapes, its own
        colors, its own way of answering a beat. Each one is written by
        somebody, and their name stays on it. These are some of them, recorded
        from Uzume and published unedited.
      </p>
      {/* Six cards named six scenes and all six went to the same place. The
          ids exist on /gallery, so the fix is the href — see the lychee
          exclusion in .github/workflows/site.yml for why the link check cannot
          verify these six and why that is safe. */}
      <div class="uz-preset-gallery">
        {featured.map(({ clip, preset }) => (
          <a class="preset-link" href={`/gallery/#${clip.slug}`}>
            {/* thumbs, not posters. A card draws 438 CSS px at its widest and the
                full poster is 1920 wide — the <video poster> size, which these cards
                only ever borrowed because both came from the same manifest key. */}
            <PresetCard
              name={preset.name}
              author={preset.author}
              poster={clip.thumbs.jpeg.url}
              posterAvif={clip.thumbs.avif?.url}
            />
          </a>
        ))}
      </div>
      <p class="presets__note">
        Anyone can write one. The ones that make it in become part of what every
        listener sees. The code, and the guide to writing a scene, are{" "}
        <a href={REPO}>on GitHub</a>.
      </p>
      <div class="band__actions">
        <Button variant="secondary" href="/gallery/">
          See the gallery
        </Button>
        <Button variant="quiet" href={`${REPO}/blob/main/CONTRIBUTING.md`}>
          Write a scene
        </Button>
      </div>
    </section>

    {/* Was a band like any other, arriving last and reading as an afterthought
        — which is a waste, because this is the story the whole thing is named
        after and the page otherwise ends on housekeeping. Full width, its own
        ground, and the type at reading scale rather than footnote scale. The
        name is the display moment; the telling is what earns it. */}
    <section class="myth">
      <h2>The name</h2>
      <p>
        In the <em>Kojiki</em>, the sun shuts herself in a cave and the world
        goes dark. A plan is made, a mirror is hung to catch light that does not
        yet exist, and Ame-no-Uzume stamps out a rhythm and dances until the
        gods roar. The sun opens the door to see what could possibly be worth
        that much noise.
      </p>
      <p class="myth__close">
        The dancing is what brings the light out. That is the whole idea.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---- Frame ---- */

  main {
    display: flow-root;
    --page-column: calc(var(--content-reading) - 2 * var(--page-gutter));
  }

  main > section:not(.hero) {
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-rows: auto auto;
    text-align: center;
  }

  .hero__stage {
    grid-area: 1 / 1;
    position: relative;
    /* 34rem on a tall window; on a short one the band yields rather than
       pushing the ask off the screen. At 1366x700 the primary action sat at
       top: 737 — below the fold — while the platform requirement sat above it,
       which is the inversion DESIGN.md:202 legislates against. */
    height: min(34rem, 56.25vw, 60svh);
    min-height: 18rem;
    overflow: hidden;
    --uz-loop-position: 40% 70%;
    animation: hero-opening var(--duration-deliberate) var(--ease-out) backwards;
  }

  @keyframes hero-opening {
    from {
      opacity: 0;
    }
  }

  .hero__stage::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 50% 80% at 100% 0%,
        color-mix(in srgb, var(--color-canvas) 68%, transparent) 0%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--color-canvas) 4%, transparent) 20%,
        color-mix(in srgb, var(--color-canvas) 8%, transparent) 40%,
        color-mix(in srgb, var(--color-canvas) 8%, transparent) 78%,
        color-mix(in srgb, var(--color-canvas) 16%, transparent) 82%,
        color-mix(in srgb, var(--color-canvas) 32%, transparent) 86%,
        color-mix(in srgb, var(--color-canvas) 55%, transparent) 90%,
        color-mix(in srgb, var(--color-canvas) 78%, transparent) 94%,
        color-mix(in srgb, var(--color-canvas) 94%, transparent) 97%,
        var(--color-canvas) 100%
      );
  }

  /* Name and sentence as one lockup, centred on the band. The top padding is
     the fixed header's own height, so the group stays clear of it on short
     bands without moving on tall ones. Still the timeline the header rides. */
  .hero__lockup {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: center;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: 4.5rem var(--page-gutter) 0;
    view-timeline: --uz-hero-lockup block;
  }

  .hero__lockup h1 {
    margin: 0;
    font: var(--font-weight-semibold) clamp(3.5rem, 10vw, 7rem) /
      var(--leading-tight) var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    /* The scrim is the shape of the letters, so the sky keeps its light
       everywhere else. Sized in em so it tracks the clamp. */
    text-shadow:
      0 0 0.05em color-mix(in srgb, var(--color-canvas) 70%, transparent),
      0 0 0.18em color-mix(in srgb, var(--color-canvas) 50%, transparent),
      0 0 0.55em color-mix(in srgb, var(--color-canvas) 32%, transparent);
  }

  .hero__claim {
    max-width: 34rem;
    margin: 0;
    font: var(--font-weight-semibold) clamp(1.125rem, 2.4vw, 1.625rem) /
      var(--leading-heading) var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    text-wrap: balance;
    text-shadow:
      0 0 0.08em color-mix(in srgb, var(--color-canvas) 78%, transparent),
      0 0 0.3em color-mix(in srgb, var(--color-canvas) 60%, transparent),
      0 0 0.8em color-mix(in srgb, var(--color-canvas) 40%, transparent);
  }

  .signup {
    padding-block: var(--space-16);
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .signup__what {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .signup__icon {
    flex: none;
    width: 4rem;
    height: 4rem;
  }

  .signup__specs {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-tertiary);
    text-wrap: pretty;
  }

  .signup :global(.notify) {
    align-items: center;
    text-align: center;
    width: min(40rem, 100%);
  }

  /* ---- Bands ---- */

  .band {
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-line);
  }

  .band > h2 {
    margin: 0 0 var(--space-6);
    font: var(--font-weight-semibold) var(--text-3xl) / var(--leading-tight)
      var(--font-display);
    letter-spacing: var(--tracking-display);
  }

  /* --measure-copy is 68ch, which is right for sustained body reading and
     wrong here: these are two- and three-line section openers sitting above
     content that spans the whole 928px column, so at 593px they read as
     indented rather than as deliberate. A standfirst takes a wider measure
     than body copy for exactly this reason. */
  .lede {
    max-width: 48rem;
    margin: 0 0 var(--space-8);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .band__actions {
    margin-top: var(--space-8);
  }

  .beats {
    display: grid;
    gap: var(--space-16);
  }

  .beat {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  /* Two columns and the alternation are one decision, so they share one
     breakpoint. They were separate: `auto-fit, minmax(20rem, 1fr)` collapsed
     the grid on its own while `order: 2` stayed on at every width, so once the
     beats stacked, the second one — "It analyzes" — put its screenshot above
     its own heading. A reader met the evidence before the claim it was evidence
     for, and only in that one beat.

     46rem is where `auto-fit` used to break: two 20rem tracks plus a 2rem gap
     is 42rem of content, and the gutter is 4vw until it reaches its 3rem
     ceiling. Stated as a query rather than inferred from track sizes, the two
     rules cannot drift apart again. */
  @media (min-width: 46rem) {
    .beat {
      grid-template-columns: 1fr 1fr;
    }

    /* The evidence changes sides down the band, so three rows of the same
       anatomy do not read as three identical slabs. */
    .beat:nth-child(even) .beat__copy {
      order: 2;
    }
  }

  .beat__copy h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  .beat__copy p {
    margin: 0;
    max-width: var(--measure-copy);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .presets__note a {
    color: var(--color-text-primary);
  }

  .presets__note {
    max-width: 48rem;
    margin: var(--space-8) 0 0;
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Cards are links now. The card's own chrome is unchanged; this only makes
     the whole tile the target and gives it a focus ring. */
  .preset-link {
    display: block;
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
  }

  .preset-link:focus-visible {
    outline: 0;
    box-shadow: var(--focus-ring);
  }

  .preset-link:hover :global(.uz-preset-card) {
    border-color: var(--color-accent);
  }

  /* The window keeps its own rounded corners, so the frame only needs a hairline
     to sit it on the canvas. Height comes from the file's own dimensions — each
     capture is cropped to its content, so they do not share a ratio and should
     not be forced into one. */
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  /* ---- The name ---- */

  /* Its own ground, full width, so the page closes on the story rather than
     trailing off into a footer. */
  .myth {
    padding-block: var(--space-24);
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    text-align: center;
  }

  .myth h2 {
    margin: 0 0 var(--space-10);
    font: var(--font-weight-semibold) clamp(2.5rem, 6vw, 4rem) /
      var(--leading-tight) var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
  }

  .myth p {
    max-width: 38rem;
    margin: 0 auto var(--space-6);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .myth__close {
    margin-bottom: 0;
    color: var(--color-text-primary);
  }

  /* ---- Footer ---- */
</style>
