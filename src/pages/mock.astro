---
// MOCK — not a shipping page. Noindex, like /design.
//
// The W.5a homepage brief rendered at full fidelity: real tokens, real fonts,
// real posters from R2, real components. It exists to be judged before the
// real page is rewritten against it, and it is deleted or promoted once that
// judgement lands. Nothing here is invented: the only gap on the page — the
// application captures — renders as a labelled gap, because PRODUCT.md says
// no application assets exist in this repo and must not be fabricated.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";
import NotifyForm from "../components/NotifyForm.astro";
import VideoTile from "../components/VideoTile.astro";
import PresetCard from "../components/PresetCard.astro";
import { getCollection } from "astro:content";
import media from "../data/media.json";

const REPO = "https://github.com/hoaxpoet/uzume";

// Matt's line, and the page's spine: listens, analyzes, accompanies. The
// previous claim led on stem separation, which is expensive and largely
// unavailable on the streaming path — where most visitors will be — so it was
// false for the majority case. Musicality is the umbrella that is true on both
// paths.
const claim =
  "A music visualizer for macOS that listens, analyzes, and accompanies.";

const hero = media.find((clip) => clip.role === "hero")!;
const presets = await getCollection("presets");
const teasers = media
  .filter((clip) => clip.role === "gallery")
  .map((clip) => ({
    clip,
    preset: presets.find((entry) => entry.data.slug === clip.slug)!.data,
  }));

// Evidence of accompaniment, shown rather than asserted — and pulled OUT of
// the featured row below, so the page never shows the same clip twice.
const accompanist = teasers.find(({ clip }) => clip.slug === "skein")!;
const featured = teasers.filter(({ clip }) => clip.slug !== "skein");

// Three beats, each with its own evidence. Two await real captures; the third
// is a preset already published. Rows, not a three-up grid — the grid was the
// same shape as the band that followed it, which made the page read as two
// helpings of the same thing.
const beats = [
  {
    title: "It listens",
    body: "With local files, Uzume hears the whole playlist before it plays a note. With anything else — a streaming app, a browser tab — it listens to what is actually coming out of your Mac.",
    capture:
      "Performance Preflight — audio source, display, eligible scenes, quality, accessibility.",
  },
  {
    title: "It analyzes",
    body: "It measures what is in the music rather than how loud it is: where the beats fall, how dense the arrangement is, where the energy sits, how the harmony moves.",
    capture:
      "Preparation Stage — progress, elapsed time, and the Listening → Separating → Understanding → Composing trace.",
  },
  {
    title: "It accompanies",
    body: "Scenes are written to answer particular things in the music — a beat lands here, the harmony moves a colour there — so what you see follows the music instead of twitching at its volume.",
  },
];

---

<Base title="MOCK — Uzume homepage" description={claim} noindex>
  <Nav overlay />

  <p class="mock-flag">
    Mock of the W.5a homepage brief. Not linked, not indexed, not shipping.
  </p>

  <main id="main">
    <section class="hero">
      <div class="hero__stage">
        <VideoTile
          bare
          title={hero.preset}
          poster={hero.posters.jpeg.url}
          sources={hero.renditions}
        />
      </div>

      <h1 class="hero__lockup">Uzume</h1>

      <div class="hero__copy">
        <p class="hero__claim">{claim}</p>

        {/* Status before the ask. On the live page this sits below the email
            field in tertiary grey, so the sequence a visitor gets is claim →
            ask → "actually there's nothing yet". Inverted here, and at body
            weight: someone who knows what they are waiting for resents the
            wait less. "Free" and "open source" surface here rather than in
            row four of the requirements table. */}
        {/* Names the thing that is coming. "The source is public" is jargon
            for the listener this page is written to, and the sentence never
            said what a visitor would eventually get. Two short lines: what is
            coming, then who can have something today — the second addressed to
            the people it is actually for, so nobody else reads it as a
            requirement. */}
        <p class="hero__status">
          Uzume hasn't launched yet. The public beta will be free and open
          source.
        </p>
        <p class="hero__meta">
          For Apple silicon Macs, macOS 14 or later. If you build software, the
          code is <a href={REPO}>on GitHub</a> today.
        </p>

        {/* Four pieces of text were saying the same thing: the status line, the
            label, the terms, and the button. The status line above has already
            established what there is to wait for, so the label only has to name
            the ask and the terms only have to say what it costs. */}
        <NotifyForm
          label="Email me when it's ready"
          terms="One email when there's a build. Unsubscribe any time."
        />
      </div>
    </section>

    {/* The plant. Somebody reads a word they do not know, set in 112px type,
        and immediately wants to know what it means — answering that here, in
        one line, is hospitable and it sets up the ending. The telling itself
        is held back to the close, where it pays off. */}
    <p class="plant">
      Uzume — <span>oo-ZOO-meh</span> — is named after a dancer who brought the
      light back.
    </p>

    <section class="band beats-band">
      {/* Rows, not a three-up grid. Each claim sits beside the thing that
          proves it, which is also what stops this band and the one after it
          reading as two helpings of the same layout. */}
      <h2>What it does</h2>
      <div class="beats">
        {beats.map(({ title, body, capture }) => (
          <article class="beat">
            <div class="beat__copy">
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
            <div class="beat__evidence">
              {capture ? (
                <div class="screen__gap">
                  <strong>Capture needed</strong>
                  <span>{capture}</span>
                </div>
              ) : (
                <VideoTile
                  title={accompanist.preset.name}
                  meta={`${accompanist.preset.author} · ${accompanist.preset.family}`}
                  poster={accompanist.clip.posters.jpeg.url}
                  sources={accompanist.clip.renditions}
                />
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Was two sections, in the wrong order: seven presets shown, then a
        section explaining what a preset is. The definition comes first now,
        and the people who write them stay with the thing they write. */}
    <section class="band">
      <h2>Featured scenes</h2>
      <p class="lede">
        A scene is one way of drawing the music — its own shapes, its own
        colours, its own way of answering a beat. Each one is written by
        somebody, and their name stays on it. These are some of them, recorded
        from Uzume and published unedited.
      </p>
      <div class="uz-preset-gallery">
        {featured.map(({ clip, preset }) => (
          <a class="preset-link" href={`/gallery#${clip.slug}`}>
            <PresetCard
              name={preset.name}
              author={preset.author}
              poster={clip.posters.jpeg.url}
            />
          </a>
        ))}
      </div>
      <p class="presets__note">
        Anyone can write one. The ones that make it in become part of what
        every listener sees.
      </p>
      <div class="band__actions">
        <Button variant="secondary" href="/gallery">See the gallery</Button>
        <Button variant="quiet" href={`${REPO}/blob/main/CONTRIBUTING.md`}>
          Write a scene
        </Button>
      </div>
    </section>

    {/* Was a band like any other, arriving last and reading as an afterthought
        — which is a waste, because this is the story the whole thing is named
        after and the page otherwise ends on housekeeping. Full width, its own
        ground, and the type at reading scale rather than footnote scale. The
        name is the display moment; the telling is what earns it. */}
    <section class="myth">
      <h2>The name</h2>
      <p>
        In the <em>Kojiki</em>, the sun shuts herself in a cave and the world
        goes dark. A plan is made, a mirror is hung to catch light that does not
        yet exist, and Ame-no-Uzume stamps out a rhythm and dances until the
        gods roar. The sun opens the door to see what could possibly be worth
        that much noise.
      </p>
      <p class="myth__close">
        The dancing is what brings the light out. That is the whole idea.
      </p>
    </section>
  </main>

  {/* Footer with the Coleridge line demoted: small type beside the
      attribution instead of a centred 2xl blockquote. BRAND.md asks it to be
      "an atmospheric close, not the product explanation", which is an argument
      for keeping it and against giving it the last word at display size. */}
  <footer class="footer">
    <div class="footer__meta">
      <p>
        Uzume · <a href={REPO}>Source on GitHub</a>
      </p>
      <p class="footer__tagline">
        “A light in sound, a sound-like power in light.” — Coleridge, 1795
      </p>
      <p>&copy; {new Date().getFullYear()} Matt Deming</p>
    </div>
  </footer>
</Base>

<style>
  .mock-flag {
    position: fixed;
    z-index: 20;
    inset-block-start: 0;
    inset-inline: 0;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    background: var(--color-status-warning-background);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    text-align: center;
  }

  /* ---- Frame. Lifted unchanged from index.astro: the hero is untouched. ---- */

  main {
    display: flow-root;
    --page-column: calc(64rem - 2 * var(--page-gutter));
  }

  main > section:not(.hero) {
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    text-align: center;
  }

  .hero__stage {
    grid-area: 1 / 1;
    position: relative;
    height: min(25rem, 56.25vw);
    overflow: hidden;
    --uz-loop-position: 40% 70%;
    animation: hero-opening var(--duration-deliberate) var(--ease-out) backwards;
  }

  @keyframes hero-opening {
    from {
      opacity: 0;
    }
  }

  .hero__stage::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 50% 80% at 100% 0%,
        color-mix(in srgb, var(--color-canvas) 68%, transparent) 0%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--color-canvas) 4%, transparent) 20%,
        color-mix(in srgb, var(--color-canvas) 8%, transparent) 40%,
        color-mix(in srgb, var(--color-canvas) 8%, transparent) 78%,
        color-mix(in srgb, var(--color-canvas) 16%, transparent) 82%,
        color-mix(in srgb, var(--color-canvas) 32%, transparent) 86%,
        color-mix(in srgb, var(--color-canvas) 55%, transparent) 90%,
        color-mix(in srgb, var(--color-canvas) 78%, transparent) 94%,
        color-mix(in srgb, var(--color-canvas) 94%, transparent) 97%,
        var(--color-canvas) 100%
      );
  }

  .hero__lockup {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: center;
    z-index: 1;
    margin: 0;
    padding: 4.5rem var(--page-gutter) 0;
    font: var(--font-weight-semibold) clamp(4rem, 11vw, 7rem) /
      var(--leading-tight) var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    text-shadow:
      0 0 0.05em color-mix(in srgb, var(--color-canvas) 70%, transparent),
      0 0 0.18em color-mix(in srgb, var(--color-canvas) 50%, transparent),
      0 0 0.55em color-mix(in srgb, var(--color-canvas) 32%, transparent);
    view-timeline: --uz-hero-lockup block;
  }

  /* The copy row is `1fr`, so it absorbs whatever the band leaves. Top-aligned
     it left a hole between the form and the section below — worse now the copy
     is shorter than it used to be. Centring the column in its own row spends
     that space on both sides instead of dumping it all underneath. */
  .hero__copy {
    grid-area: 2 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding-block: var(--space-8);
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
  }

  .hero__copy :global(.notify) {
    align-items: center;
    text-align: center;
    margin-block: var(--space-6) 0;
    width: min(38rem, 100%);
  }

  .hero__claim {
    max-width: 40rem;
    margin: 0;
    /* Clamped. --text-3xl is a fixed 2.5rem in tokens.css while --text-4xl
       beside it is clamped, which is why the live claim runs four lines at
       375px. Local override here; the token fix is its own change. */
    font: var(--font-weight-semibold) clamp(1.75rem, 4.5vw, 2.5rem) /
      var(--leading-heading) var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .hero__status {
    max-width: 38rem;
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .hero__meta {
    max-width: 38rem;
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-tertiary);
    text-wrap: pretty;
  }

  .hero__meta a {
    color: var(--color-text-secondary);
  }

  /* ---- Bands ---- */

  .band {
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-line);
  }

  .band > h2 {
    margin: 0 0 var(--space-6);
    font: var(--font-weight-semibold) clamp(1.75rem, 4.5vw, 2.5rem) /
      var(--leading-tight) var(--font-display);
    letter-spacing: var(--tracking-display);
  }

  .lede {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-8);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .band__actions {
    margin-top: var(--space-8);
  }

  .beats {
    display: grid;
    gap: var(--space-16);
  }

  .beat {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-8);
    align-items: center;
  }

  /* The evidence changes sides down the band, so three rows of the same
     anatomy do not read as three identical slabs. */
  .beat:nth-child(even) .beat__copy {
    order: 2;
  }

  .beat__copy h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-heading);
  }

  .beat__copy p {
    margin: 0;
    max-width: var(--measure-copy);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .presets__note {
    max-width: var(--measure-copy);
    margin: var(--space-8) 0 0;
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Cards are links now. The card's own chrome is unchanged; this only makes
     the whole tile the target and gives it a focus ring. */
  .preset-link {
    display: block;
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
  }

  .preset-link:focus-visible {
    outline: 0;
    box-shadow: var(--focus-ring);
  }

  .preset-link:hover :global(.uz-preset-card) {
    border-color: var(--color-accent);
  }

  /* Reads as an empty slot, not as an interface: a dashed frame and a plain
     sentence, so there is no way to mistake it for a screenshot. */
  .screen__gap {
    aspect-ratio: 16 / 9;
    display: grid;
    align-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-align: center;
  }

  .screen__gap strong {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-tertiary);
  }

  .screen__gap span {
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  /* ---- The name ---- */

  /* Its own ground, full width, so the page closes on the story rather than
     trailing off into a footer. */
  .myth {
    padding-block: var(--space-24);
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    text-align: center;
  }

  .myth h2 {
    margin: 0 0 var(--space-10);
    font: var(--font-weight-semibold) clamp(2.5rem, 6vw, 4rem) /
      var(--leading-tight) var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
  }

  /* The plant, between the hero and the first band. Not a section and not a
     heading — a single line that answers the question the wordmark just raised
     and hands the reader on. */
  .plant {
    margin: 0;
    padding-block: var(--space-16);
    padding-inline: max(var(--page-gutter), calc(50% - var(--page-column) / 2));
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-align: center;
    text-wrap: pretty;
  }

  .plant span {
    color: var(--color-text-tertiary);
    letter-spacing: var(--tracking-label);
  }

  .myth p {
    max-width: 38rem;
    margin: 0 auto var(--space-6);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .myth__close {
    margin-bottom: 0;
    color: var(--color-text-primary);
  }

  /* ---- Footer ---- */

  .footer {
    padding: var(--space-10) var(--page-gutter) var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .footer__meta p {
    margin: 0;
  }

  .footer__tagline {
    color: var(--color-text-tertiary);
  }
</style>
