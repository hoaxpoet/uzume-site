---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import VideoTile from "../components/VideoTile.astro";
import Button from "../components/Button.astro";
import NotifyForm from "../components/NotifyForm.astro";
import media from "../data/media.json";

const description =
  "Scenes recorded from Uzume, unedited and silent, each with the name of the person who wrote it.";

// The preset entries are generated from the app repo's sidecars
// (Scripts/generate_presets.py); the footage is the encoder's manifest. Slug is
// the join. The manifest runs in capture order, so sort the hero to the end —
// Murmuration already opens the landing page, and the presets a visitor has not
// seen should come first.
const REPO = "https://github.com/hoaxpoet/uzume";

const presets = await getCollection("presets");
const performances = media
  .map((clip) => {
    const preset = presets.find((entry) => entry.data.slug === clip.slug);
    if (!preset) throw new Error(`no preset entry for ${clip.slug}`);
    return { ...preset.data, clip };
  })
  .sort((a, b) => Number(a.clip.role === "hero") - Number(b.clip.role === "hero"));
---

<Base title="Gallery — Uzume" description={description}>
  <Nav />

  <main id="main">
    <header class="intro">
      <h1>What Uzume draws</h1>
      <p class="intro__lede">
        Every clip below is Uzume drawing a scene to music, recorded and
        published unedited. Nothing is reconstructed and nothing is added on
        afterwards — this is what you would see.
      </p>
      <p class="intro__note">
        These are the scenes recorded so far — Uzume has more, and more are
        being written. The rest arrive here as they are captured. Every clip is
        silent: they are driven by music, but the footage carries no audio
        track.
      </p>
      {/* This is the page that plays the bright loops, so this is the page
          that owes the commitment. It was stated only on the landing page,
          which a visitor arriving on a shared /gallery link has never seen.

          Said in the reader's words: "certification" is internal vocabulary
          and means nothing to a listener, so the sentence describes the test
          instead of naming the badge. The standard itself is still named as
          the app gates it (D-157) — a bounded per-frame change in brightness,
          never a flashes-per-second figure. */}
      <p class="intro__note">
        Every scene here is tested for steady luminance: a bounded change in
        brightness from frame to frame, with beat-locked motion confined to
        parts of the frame rather than thrown across all of it. If your system
        asks for reduced motion, nothing on this page moves until you play it.
      </p>
    </header>

    {performances.map(
      ({ name, author, family, inspired_by, caption, clip }) => (
        <article class="performance" id={clip.slug}>
          <VideoTile
            titleAs="h2"
            title={name}
            meta={`${author} · ${family}`}
            poster={clip.posters.jpeg.url}
            posterAvif={clip.posters.avif?.url}
            sources={clip.renditions}
          />
          {caption && <p class="performance__caption">{caption}</p>}
          {inspired_by && (
            <p class="performance__lineage">
              After “{inspired_by.milkdrop_filename}” by{" "}
              {inspired_by.original_artist}, from {inspired_by.pack}.
            </p>
          )}
        </article>
      ),
    )}

    <section class="outro">
      <h2>Your scene could be the next one here</h2>
      <p>
        Scenes are written by people, not shipped by a company. Write one, and
        if it makes it in it joins this page with your name on it, among
        these.
      </p>
      <div class="outro__actions">
        <Button variant="secondary" href={`${REPO}/blob/main/CONTRIBUTING.md`}>
          Write a scene
        </Button>
      </div>

      <div class="outro__notify">
        <NotifyForm />
      </div>

      <p class="outro__rights">
        Captured against “Delinquent Frequencies” — The Goddamn Shame,{" "}
        <em>Dispatches from the Grey City</em> (EP, 2006, self-released), used
        with the permission of the songwriters and the band. The clips carry no
        audio track.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  main {
    max-width: var(--content-default);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .intro {
    padding: var(--space-16) 0 var(--space-12);
  }

  .intro h1 {
    margin: 0 0 var(--space-6);
    font: var(--font-weight-semibold) var(--text-4xl) / var(--leading-tight)
      var(--font-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .intro__lede {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .intro__note {
    max-width: var(--measure-copy);
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-tertiary);
  }

  /* BRAND.md: a few large, immersive frames, never a grid of thumbnails. One
     performance per row at every width; the notes sit beside the frame only
     when there is room for both without shrinking the footage. */
  .performance {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-line);
    /* The header on this page is sticky, so an anchor jump would otherwise
       land the scene's own title underneath it. */
    scroll-margin-top: calc(4.5rem + var(--space-6));
  }

  /* Milkdrop lineage, where a preset has it. All eight published are
     Matt's originals; Nacre is the first with a lineage to render, and it is
     held out of the manifest until it can be encoded in budget. */
  /* What the visitor is looking at, and what in the music drives it. Without
     it a silent loop cannot demonstrate the one thing this page exists to
     prove. Authored in Scripts/preset_captions.json, not lifted from the
     sidecar's own maintainers-first description. */
  .performance__caption {
    max-width: var(--measure-copy);
    margin: var(--space-6) 0 0;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .performance__lineage {
    max-width: var(--measure-copy);
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-text-tertiary);
  }

  .outro {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-line);
  }

  .outro h2 {
    margin: 0 0 var(--space-4);
    font: var(--font-weight-semibold) var(--text-3xl) / var(--leading-tight)
      var(--font-display);
    letter-spacing: var(--tracking-display);
  }

  .outro p {
    max-width: var(--measure-copy);
    margin: 0 0 var(--space-6);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  /* The page that convinces people had no way out of it: its last focusable
     element was the footer's GitHub link. Both audiences get a door now — the
     contributor a repository, the listener the same form the landing page
     offers, because this is where they are persuaded. */
  .outro__actions {
    margin-bottom: var(--space-16);
  }

  .outro__notify {
    display: flex;
    justify-content: center;
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-line);
  }

  .outro__notify :global(.notify) {
    align-items: center;
    text-align: center;
  }

  .outro__rights {
    margin-bottom: 0;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }
</style>
