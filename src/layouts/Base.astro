---
// The one place tokens.css is imported. Every page inherits it through this layout.
// tokens.css stays at the repo root, unmodified — the fast-gate contrast check
// runs against that path.
import "../../tokens.css";
import "../styles/fonts.css";
import { CF_BEACON_SRC, CF_BEACON_DATA } from "../beacon.mjs";

interface Props {
  title: string;
  description: string;
  /** Keeps a page out of search results. For pages reached only by a link in an
      email — /confirmed — where a search result would be a dead end. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// brand/social/Uzume-GitHub-Social-Preview.png, copied unmodified (BRAND.md:
// reference or copy, never regenerate). 1280x640 is inside the 2:1 that both
// X and Facebook accept for a large card. img-src is 'self', so it is ours.
const socialCard = new URL("/uzume-social.png", Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- The page is midnight at every width; without this the mobile browser
         chrome paints a light bar above it. Midnight literal rather than
         var(--color-canvas): a meta value cannot read a custom property. -->
    <meta name="theme-color" content="#0B0C10" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <!-- Without these every share of uzume.io renders as a bare URL string. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Uzume" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Uzume" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <!-- Cloudflare Web Analytics; is:inline keeps Astro from bundling it. -->
    <script
      is:inline
      type="module"
      src={CF_BEACON_SRC}
      data-cf-beacon={CF_BEACON_DATA}
    ></script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* A class rule with its own `display` outranks the UA style for [hidden],
     so toggling el.hidden silently does nothing. Guard it once, here. */
  [hidden] {
    display: none !important;
  }

  /* Lets the fixed header in Nav.astro drive its handoff off the hero's h1 in
     index.astro. They are siblings, so the scope has to live on the ancestor. */
  body {
    timeline-scope: --uz-hero-lockup;
    margin: 0;
    background: var(--color-canvas);
    color: var(--color-text-primary);
    font-family: var(--font-text);
    font-weight: var(--font-weight-regular);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--color-accent);
  }

  /* Visible only once focused — the first tab stop on every page, ahead of the
     nav's own links. Starlight ships its own on /docs. */
  .skip-link {
    position: absolute;
    /* 44x44 minimum; the padding alone came to 43. */
    min-height: var(--target-min-web);
    display: inline-flex;
    align-items: center;
    left: var(--space-4);
    top: var(--space-4);
    z-index: 10;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-4)));
  }

  .skip-link:focus-visible {
    transform: none;
  }

  a:focus-visible {
    outline: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--focus-ring);
  }

  /* Motion is an enhancement, never a requirement. There is none yet; this keeps
     it that way for anything added later. */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
