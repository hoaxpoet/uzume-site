.DS_Store
node_modules/
dist/
**/.build/
**/__pycache__/
*.py[cod]
.impeccable/config.local.json

# astro
.astro/

.env
.env.*

# Media lives in R2 at media.uzume.io, never in git (CLAUDE.md). A 1.4 GB capture
# once landed untracked in docs/planning/ one `git add .` away from a commit.
*.mov
*.mp4
*.m4v

# impeccable ships a 12 MB platform binary per skill copy; the launcher
# re-fetches or falls back to ~/.impeccable when it is absent.
.claude/skills/impeccable/scripts/bin/
.agents/skills/impeccable/scripts/bin/
