{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "uzume-site",
      "runtimeExecutable": "/opt/homebrew/opt/node@24/bin/npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "uzume-site-worker",
      "runtimeExecutable": "/opt/homebrew/opt/node@24/bin/npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8788"
      ],
      "port": 8788
    },
    {
      "name": "uzume-site-built",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "preview"
      ],
      "autoPort": true
    }
  ]
}
